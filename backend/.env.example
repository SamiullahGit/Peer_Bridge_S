PORT=4000
MONGO_URI=mongodb://localhost:27017/peer_bridge
JWT_SECRET=peer_bridge_secret_change_this_in_production
NODE_ENV=development

# Email (for OTP - optional in dev mode)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary (optional - enables persistent uploads in production).
# If all three are set, uploads go to Cloudinary; otherwise they go to
# backend/uploads/ on the local disk. Get free creds at cloudinary.com.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
