PORT=4000
JWT_SECRET=peer_bridge_secret_change_this_in_production
NODE_ENV=development

# ── Supabase (PostgreSQL) ──────────────────────────────────────────────
# Project Settings -> API in the Supabase dashboard.
#   SUPABASE_URL              : the Project URL, e.g. https://abcd1234.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY : the "service_role" secret key (NOT the anon key).
# The service-role key bypasses RLS - keep it server-side only, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (OTP + admin notifications) ──────────────────────────────────
# Preferred: Brevo HTTP API (works on hosts that block SMTP, e.g. Render).
#   BREVO_API_KEY : Brevo (Sendinblue) v3 API key
#   MAIL_FROM     : the email you VERIFIED as a sender in Brevo (e.g. your Gmail)
BREVO_API_KEY=
MAIL_FROM=

# Fallback: Gmail SMTP (often blocked/stalled on cloud hosts). Used only if
# BREVO_API_KEY is not set. EMAIL_USER also acts as MAIL_FROM if MAIL_FROM is blank.
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password

# CORS: leave blank for local dev ("*"). In production set to your frontend
# URL(s), comma-separated, e.g. https://peer-bridge.vercel.app
CORS_ORIGIN=

# File uploads go to Supabase Storage. Optional: override the bucket name
# (created automatically on startup as a public bucket). Defaults to "uploads".
SUPABASE_BUCKET=uploads

# ── Ask Baba (AI study assistant) ──────────────────────────────────────
# OpenRouter API key (free tier works). Create one at https://openrouter.ai/keys
# Powers the floating "Ask Baba" assistant. If blank, the feature is disabled.
OPENROUTER_API_KEY=
